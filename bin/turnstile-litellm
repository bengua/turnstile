#!/usr/bin/env python3
"""turnstile-litellm — the gateway's model list, generated from the map.

The map is the only source of truth about what can run. A gateway config
written by hand is a second copy, and a second copy drifts: on the fleet this
was written for, the hand-written LiteLLM config still pointed at ports that
had not existed for two weeks, and nothing said so.

One entry per slot, named exactly like the slot. No role aliases and no
fallback chains: a fallback makes another model answer under the name that
was asked for, which is the one lie the turnstile exists to prevent. A slot
that is not loaded answers with a connection error, and that is the truth.

Usage:
    turnstile-litellm > config.yaml
"""
import os
import re
import sys


def _first_existing(*paths):
    for p in paths:
        p = os.path.expanduser(p)
        if os.path.exists(p):
            return p
    return os.path.expanduser(paths[0])


MAP = os.environ.get("TURNSTILE_MAP") or _first_existing(
    "~/.config/turnstile/containers.map", "/etc/turnstile/containers.map")
HOST = os.environ.get("TURNSTILE_LITELLM_HOST", "127.0.0.1")
TIMEOUT = int(os.environ.get("TURNSTILE_LITELLM_TIMEOUT", "1800"))


def read_slots(path):
    with open(path) as f:
        lines = f.read().splitlines()
    slots = []
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        fields = line.split("|")
        if len(fields) < 5 or not fields[1].isdigit():
            continue
        m = re.search(r"-m\s+(\S+)", fields[4])
        c = re.search(r"(?:^|\s)-c\s+(\d+)", fields[4])
        slots.append({"name": fields[0], "port": int(fields[1]),
                      "model": m.group(1) if m else None,
                      "context": int(c.group(1)) if c else None})
    return slots


def q(s):
    """A YAML double-quoted scalar."""
    return '"' + str(s).replace("\\", "\\\\").replace('"', '\\"') + '"'


def render(slots, source):
    out = [f"# GENERATED by turnstile-litellm from {source}. Do not edit:",
           "# regenerate instead. One entry per slot, named like the slot.",
           "model_list:"]
    for s in slots:
        base = f"http://{HOST}:{s['port']}/v1"
        out += [f"  - model_name: {q(s['name'])}",
                "    litellm_params:",
                f"      model: {q('openai/' + (s['model'] or s['name']))}",
                f"      api_base: {q(base)}",
                '      api_key: "none"',
                f"      timeout: {TIMEOUT}",
                f"      stream_timeout: {TIMEOUT}",
                "      num_retries: 0"]
        if s["context"]:
            out += ["    model_info:",
                    f"      max_input_tokens: {s['context']}"]
    return "\n".join(out) + "\n"


def main():
    try:
        slots = read_slots(MAP)
    except OSError as e:
        sys.exit(f"map unreadable: {e}")
    if not slots:
        sys.exit(f"no slot in {MAP}: refusing to write an empty gateway")
    names = [s["name"] for s in slots]
    if len(names) != len(set(names)):
        sys.exit("two slots share a name")
    sys.stdout.write(render(slots, MAP))


if __name__ == "__main__":
    main()
